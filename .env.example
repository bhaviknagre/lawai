# ─── Core ───────────────────────────────────────────────────────────────
# Postgres 15+ with the pgvector extension (Neon, Supabase, RDS, or docker-compose).
DATABASE_URL=postgresql://lawai:lawai@localhost:5432/lawai
APP_URL=http://localhost:3000

# ─── AI service (Python, ./ai) ─────────────────────────────────────────
# Next.js calls the FastAPI service here. On Vercel this is injected by the service binding; don't set it there.
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret between Next.js and the AI service. Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# ─── LLM provider ─────────────────────────────────────────────────────
# anthropic (production) | groq (local testing, OpenAI-compatible API)
LLM_PROVIDER=anthropic
GROQ_API_KEY=
GROQ_MODEL_CHAT=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# ─── LLM (Anthropic Claude) ────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Main model: chat assistant, document review, drafting, research answers
ANTHROPIC_MODEL_CHAT=claude-sonnet-5-5
# Fast/cheap model: contextual retrieval during ingestion, titles
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# ─── Embeddings + reranking ───────────────────────────────────────────
# voyage (recommended: voyage-law-2 is trained on legal text) | openai | none
# With "none", retrieval falls back to Postgres full-text search only.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-law-2
VOYAGE_RERANK_MODEL=rerank-2
OPENAI_API_KEY=
# Must match the vector column size in src/db/schema.ts (1024).
EMBEDDING_DIMENSIONS=1024

# Contextual retrieval: an LLM writes a short "where this chunk sits" note
# for every chunk before embedding. Better recall, small ingestion cost.
RAG_CONTEXTUAL=true

# ─── File storage ─────────────────────────────────────────────────────
# Leave S3_BUCKET empty to store files on local disk (STORAGE_DIR).
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Ops ───────────────────────────────────────────────────────────────
# Protects /api/cron/ingest (Vercel Cron sends this as a Bearer token).
CRON_SECRET=change-me
