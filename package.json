{
  "name": "lawai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "lint": "tsc --noEmit",
    "db:setup": "tsx scripts/setup-db.ts && drizzle-kit push --force",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts && npm run ai:index",
    "db:reset": "tsx scripts/reset-db.ts && npm run db:setup && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "platform:admin": "tsx --conditions=react-server scripts/create-platform-admin.ts",
    "postbuild": "node scripts/postbuild.mjs",
    "ai:install": "cd ai && uv sync",
    "ai:dev": "cd ai && uv run uvicorn main:app --reload --port 8000",
    "ai:test": "cd ai && uv run pytest",
    "ai:index": "cd ai && uv run python -m lawai_ai.cli index",
    "ingest:pending": "cd ai && uv run python -m lawai_ai.cli ingest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
